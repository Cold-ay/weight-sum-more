    "A label says 250 kcal per 100 g. Eating 60 g gives 250 × 60 ÷ 100 = 150 kcal.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A label says 250 kcal per 100 g. Eating 60 g gives 250 × 60 ÷ 100 = 150 kcal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列明每 100 克有 250 kcal。吃了 60 克，即 250 × 60 ÷ 100 = 150 kcal。"
          }
        }
      }
    },
    "A reference bowl of cooked rice is about 242 kcal. Half that portion is about 121 kcal.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reference bowl of cooked rice is about 242 kcal. Half that portion is about 121 kcal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參考份量的一碗熟白飯約有 242 kcal，吃半份則約有 121 kcal。"
          }
        }
      }
    },
    "Weigh food when possible. Bowls and cups vary; compare with the listed reference weight.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weigh food when possible. Bowls and cups vary; compare with the listed reference weight."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "方便時可秤量食物。碗杯大小不一，請對照列出的參考重量。"
          }
        }
      }
    },
